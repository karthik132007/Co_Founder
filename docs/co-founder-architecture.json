  "cards": [
    {
      "dot": "cyan",
      "title": "Primary runtime path",
      "items": [
        "POST /chat is synchronous: FastAPI → CEO agent → reply",
        "WS /chat/ws streams tool calls, subagent spawns, and LLM tokens live",
        "effort tiers — flash / mid / max — control reflection depth and models"
      ]
    },
    {
      "dot": "emerald",
      "title": "Specialist line-up",
      "items": [
        "Researcher (budget-aware Tavily web search)",
        "Writer · CMO (SerpAPI market data) · Data Analyst (E2B code)",
        "Graphic Designer (image generation) · Judge (LLM-as-judge)",
        "Each specialist routes its own model calls via OpenRouter (choose_llm)"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & async",
      "items": [
        "FastAPI persists sessions & messages synchronously to Supabase (insert_to_sql)",
        "Supabase: companies, sessions, messages, files, pgvector embeddings",
        "Redis: company cache, session state, embedding cache (TTL 1h), CEO resources",
        "Kafka topics: session_title_creation · chat_memory · add_message_to_session — drained by three consumer containers"
      ]
    },
    {
      "dot": "amber",
      "title": "External dependencies",
      "items": [
        "OpenRouter: DeepSeek, GLM, Gemma, GPT-OSS + text-embedding-3-small",
        "Tavily Search API · SerpAPI (Google Trends / News / Shopping)",
        "E2B code-interpreter sandbox · Supabase Storage (S3-compatible)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries & security",
      "items": [
        "API keys from root .env — never baked into images",
        "CORS restricted to configured origins; rate limits on /auth, /chat, /upload",
        "Argon2id password hashing; Supabase service-role key used server-side only"
      ]
    }
  ]
}