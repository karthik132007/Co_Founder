    {
      "dot": "cyan",
      "title": "Orchestration",
      "items": [
        "CEO delegates via LangChain tools (research, writing, marketing, data, design, judging)",
        "effort tiers — flash / mid / max — gate reflection depth and model choice",
        "per-session resource budgets cap web searches, delegates, and MCQs",
        "CEO & specialists route every model call through the Model Router"
      ]
    },
    {
      "dot": "emerald",
      "title": "Specialist roles",
      "items": [
        "Researcher — budget-aware Tavily web search",
        "Writer — content drafting · CMO — SerpAPI market data (Trends/News/Shopping)",
        "Data Analyst — E2B code sandbox · Graphic Designer — image generation",
        "Judge — LLM-as-judge quality gate on deliverables"
      ]
    },
    {
      "dot": "violet",
      "title": "Shared services",
      "items": [
        "Model Router (choose_llm) picks a model per task + effort",
        "RAG + chat memory: pgvector semantic/keyword search + memory recall",
        "Observability stream: tool calls, subagent spawns, and LLM tokens → WebSocket"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust & external deps",
      "items": [
        "All agents call OpenRouter (DeepSeek, GLM, Gemma, GPT-OSS, text-embedding-3-small)",
        "Tavily · SerpAPI · E2B reached with .env API keys",
        "Supabase + Redis power RAG, chat memory, and session state"
      ]
    }
